{
  // buscaDR · Configuración de DESPLIEGUE (la usa `npx wrangler deploy` en Cloudflare Workers Builds).
  // Wrangler ejecuta primero `npm run build` y publica la salida compilada en build/.
  // El código fuente se configura en wrangler.app.jsonc: mantén ambos con los mismos bindings
  // (lo verifica scripts/check-wrangler.mjs, incluido en `npm run check` y en CI).
  // Los secretos se configuran SOLO en Cloudflare; nunca en este archivo.
  // La base D1 «buscadr-db» se crea sola en el primer despliegue (aprovisionamiento automático de Wrangler).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buscadr",
  "compatibility_date": "2026-10-20",
  "keep_vars": true,
  "workers_dev": true,
  "observability": { "enabled": true },
  "build": { "command": "npm run build" },
  "main": "build/server/index.js",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "build/client" },
  "vars": {
    "BUSCADR_ENV": "pilot",
    "BUSCADR_FEE_BPS": "800",
    "BUSCADR_PAYMENTS": "sandbox"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buscadr-db",
      "migrations_dir": "migrations"
    }
  ],
  // R2 opcional: descomenta aquí Y en wrangler.app.jsonc tras crear el bucket.
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "buscadr-media" }],
  "triggers": { "crons": ["*/30 * * * *"] }
}
